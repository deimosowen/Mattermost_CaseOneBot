<% layout('layout') -%>
    <% block('title', 'Админ-панель' ); -%>

        <style>
            .admin-stat {
                border-left: 4px solid;
                transition: transform 0.15s;
            }
            .admin-stat:hover {
                transform: translateY(-2px);
            }
            .admin-stat.green { border-left-color: var(--bs-success); }
            .admin-stat.red { border-left-color: var(--bs-danger); }
            .admin-stat.blue { border-left-color: var(--bs-primary); }
            .admin-stat.yellow { border-left-color: var(--bs-warning); }
            .health-dot {
                width: 10px; height: 10px; border-radius: 50%; display: inline-block;
            }
            .health-dot.ok { background: var(--bs-success); }
            .health-dot.err { background: var(--bs-danger); }
            .health-dot.off { background: var(--bs-secondary); }
            .admin-card {
                border: 1px solid var(--bs-border-color);
                border-radius: 0.75rem;
                overflow: hidden;
            }
            .admin-card-header {
                padding: 1rem 1.25rem;
                border-bottom: 1px solid var(--bs-border-color);
                background: var(--bs-body-bg);
            }
            .admin-card-body {
                padding: 1.25rem;
            }
            .log-viewer {
                background: #1a1b26;
                color: #a9b1d6;
                border-radius: 0.5rem;
                padding: 1rem;
                max-height: 420px;
                overflow-y: auto;
                font-family: 'Cascadia Code', 'Fira Code', 'JetBrains Mono', 'Courier New', monospace;
                font-size: 0.8rem;
                line-height: 1.6;
                white-space: pre-wrap;
                word-wrap: break-word;
            }
            [data-bs-theme="dark"] .log-viewer {
                background: #0d1117;
                color: #c9d1d9;
                border: 1px solid #30363d;
            }
            .log-viewer::-webkit-scrollbar { width: 8px; }
            .log-viewer::-webkit-scrollbar-track { background: transparent; }
            .log-viewer::-webkit-scrollbar-thumb { background: #444; border-radius: 4px; }
        </style>

        <div class="container-fluid px-4 py-3">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h3 class="mb-0"><i class="bi bi-shield-check me-2"></i>Админ-панель</h3>
                <div class="d-flex gap-2 align-items-center">
                    <small class="text-muted"><i class="bi bi-clock me-1"></i><span id="currentTime"></span></small>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="card admin-card admin-stat green shadow-sm">
                        <div class="admin-card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="text-muted small mb-1">GitLab</div>
                                    <div id="health-gitlab" class="fw-bold">—</div>
                                </div>
                                <div id="health-gitlab-dot" class="health-dot off mt-1"></div>
                            </div>
                            <div id="health-gitlab-ms" class="text-muted small mt-1"></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card admin-card admin-stat blue shadow-sm">
                        <div class="admin-card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="text-muted small mb-1">Jira</div>
                                    <div id="health-jira" class="fw-bold">—</div>
                                </div>
                                <div id="health-jira-dot" class="health-dot off mt-1"></div>
                            </div>
                            <div id="health-jira-ms" class="text-muted small mt-1"></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card admin-card admin-stat yellow shadow-sm">
                        <div class="admin-card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="text-muted small mb-1">TeamCity</div>
                                    <div id="health-teamcity" class="fw-bold">—</div>
                                </div>
                                <div id="health-teamcity-dot" class="health-dot off mt-1"></div>
                            </div>
                            <div id="health-teamcity-ms" class="text-muted small mt-1"></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card admin-card admin-stat red shadow-sm">
                        <div class="admin-card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="text-muted small mb-1">Mattermost</div>
                                    <div id="health-mattermost" class="fw-bold">—</div>
                                </div>
                                <div id="health-mattermost-dot" class="health-dot off mt-1"></div>
                            </div>
                            <div id="health-mattermost-ms" class="text-muted small mt-1"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-lg-4">
                    <div class="card admin-card shadow-sm h-100">
                        <div class="admin-card-header d-flex justify-content-between align-items-center py-2">
                            <span class="fw-semibold"><i class="bi bi-gear me-2"></i>Система</span>
                            <button class="btn btn-sm btn-outline-secondary" id="refreshSystemInfo"><i class="bi bi-arrow-clockwise"></i></button>
                        </div>
                        <div class="admin-card-body p-2" id="systemInfo">
                            <div class="text-center py-2"><div class="spinner-border spinner-border-sm text-secondary"></div></div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="card admin-card shadow-sm h-100">
                        <div class="admin-card-header py-2">
                            <span class="fw-semibold"><i class="bi bi-person-badge me-2"></i>Профиль</span>
                        </div>
                        <div class="admin-card-body py-2 px-3">
                            <div class="d-flex flex-column gap-1 small">
                                <div><span class="text-muted">Имя:</span> <span class="fw-semibold"><%= user?.displayName || 'N/A' %></span></div>
                                <div><span class="text-muted">Email:</span> <%= adminInfo?.email || 'N/A' %></div>
                                <div><span class="text-muted">MM:</span> <code class="user-select-all"><%= adminInfo?.mattermostUserId || 'N/A' %></code></div>
                                <div><span class="text-muted">Yandex:</span> <code class="user-select-all"><%= adminInfo?.yandexId || 'N/A' %></code></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card admin-card shadow-sm">
                <div class="admin-card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold"><i class="bi bi-file-text me-2"></i>Логи</span>
                    <div class="d-flex gap-2 align-items-center">
                        <select id="logDateSelect" class="form-select form-select-sm" style="width:auto;min-width:130px"></select>
                        <select id="logModuleSelect" class="form-select form-select-sm" style="width:auto;min-width:110px"></select>
                        <button class="btn btn-sm btn-outline-primary" id="refreshLog"><i class="bi bi-arrow-clockwise"></i></button>
                    </div>
                </div>
                <div class="admin-card-body p-0">
                    <div id="latestLogContainer" class="log-viewer">Загрузка...</div>
                </div>
            </div>
        </div>

        <script>
            let currentDate = '';
            let currentModule = 'app';

            document.getElementById('currentTime').textContent = new Date().toLocaleString('ru-RU');

            function setHealth(id, status, ms, message) {
                const dot = document.getElementById(`health-${id}-dot`);
                const label = document.getElementById(`health-${id}`);
                const msEl = document.getElementById(`health-${id}-ms`);
                if (status === 'ok') {
                    dot.className = 'health-dot ok';
                    label.textContent = 'Доступен';
                    label.className = 'fw-bold text-success';
                    msEl.textContent = `${ms}ms`;
                } else if (status === 'not_configured') {
                    dot.className = 'health-dot off';
                    label.textContent = 'Не настроен';
                    label.className = 'fw-bold text-muted';
                    msEl.textContent = '';
                } else {
                    dot.className = 'health-dot err';
                    label.textContent = 'Ошибка';
                    label.className = 'fw-bold text-danger';
                    msEl.textContent = message || '';
                }
            }

            async function loadHealth() {
                try {
                    const r = await fetch('/admin/api/health');
                    const data = await r.json();
                    for (const [k, v] of Object.entries(data)) {
                        setHealth(k, v.status, v.ms, v.message);
                    }
                } catch (e) {
                    ['gitlab', 'jira', 'teamcity', 'mattermost'].forEach(id => setHealth(id, 'error', null, e.message));
                }
            }

            async function loadSystemInfo() {
                const el = document.getElementById('systemInfo');
                try {
                    const r = await fetch('/admin/api/system-info');
                    const d = await r.json();
                    const mem = (d.memory.rss / 1024 / 1024).toFixed(1);
                    const hours = Math.floor(d.uptime / 3600);
                    const mins = Math.floor((d.uptime % 3600) / 60);
                    const items = [
                        { icon: 'bi-cpu', label: 'Node', value: `<code>${d.nodeVersion}</code>` },
                        { icon: 'bi-hdd', label: 'RAM', value: `${mem} MB` },
                        { icon: 'bi-clock-history', label: 'Аптайм', value: `${hours}ч ${mins}м` },
                        { icon: 'bi-database', label: 'Платформа', value: `<code>${d.platform}</code>` },
                    ];
                    if (d.database?.size) items.push({ icon: 'bi-database-fill', label: 'БД', value: `${(d.database.size / 1024 / 1024).toFixed(1)} MB` });
                    el.innerHTML = `<div class="d-flex flex-wrap gap-3">${items.map(i => `
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi ${i.icon} text-muted"></i>
                            <span class="text-muted small">${i.label}</span>
                            <span class="fw-semibold small">${i.value}</span>
                        </div>`).join('')}</div>`;
                } catch (e) {
                    el.innerHTML = `<div class="text-danger small">${e.message}</div>`;
                }
            }

            async function loadLogFiles() {
                try {
                    const r = await fetch('/admin/api/log-files');
                    const d = await r.json();
                    const sel = document.getElementById('logDateSelect');
                    sel.innerHTML = '';
                    (d.dates || []).forEach(dt => {
                        const o = document.createElement('option');
                        o.value = dt;
                        o.textContent = dt;
                        sel.appendChild(o);
                    });
                    if (d.dates?.length && !currentDate) currentDate = d.dates[0];
                    if (currentDate && d.dates?.includes(currentDate)) sel.value = currentDate;
                } catch (e) {
                    console.error(e);
                }
            }

            function updateModuleSelect(modules) {
                const sel = document.getElementById('logModuleSelect');
                const prev = sel.value || currentModule;
                sel.innerHTML = '';
                (modules || []).forEach(m => {
                    const o = document.createElement('option');
                    o.value = m;
                    o.textContent = m;
                    sel.appendChild(o);
                });
                if (modules.includes(prev)) {
                    sel.value = prev;
                    currentModule = prev;
                } else if (modules.length) {
                    currentModule = modules[0];
                    sel.value = currentModule;
                }
            }

            async function loadLatestLog() {
                const el = document.getElementById('latestLogContainer');
                try {
                    const date = document.getElementById('logDateSelect').value;
                    const mod = document.getElementById('logModuleSelect').value || 'app';
                    const p = new URLSearchParams();
                    if (date) p.set('date', date);
                    p.set('module', mod);
                    const r = await fetch(`/admin/api/latest-log?${p}`);
                    const d = await r.json();
                    if (d.currentDate) currentDate = d.currentDate;
                    if (d.currentModule) currentModule = d.currentModule;
                    if (d.availableDates) {
                        const sel = document.getElementById('logDateSelect');
                        sel.innerHTML = '';
                        d.availableDates.forEach(dt => {
                            const o = document.createElement('option');
                            o.value = dt;
                            o.textContent = dt;
                            sel.appendChild(o);
                        });
                        if (d.availableDates.includes(currentDate)) sel.value = currentDate;
                    }
                    if (d.availableModules) updateModuleSelect(d.availableModules);
                    if (d.error) {
                        el.innerHTML = `<span class="text-warning">${d.error}</span>`;
                        return;
                    }
                    if (d.logContent) {
                        const header = `# ${d.logFile} | ${d.logModified} | ${d.showingLastLines}/${d.totalLines} строк\n`;
                        el.innerHTML = (header + d.logContent)
                            .replace(/&/g, '&amp;')
                            .replace(/</g, '&lt;')
                            .replace(/>/g, '&gt;')
                            .replace(/\r\n/g, '\n')
                            .replace(/\n/g, '<br>');
                    } else {
                        el.textContent = 'Лог-файл не найден';
                    }
                } catch (e) {
                    el.innerHTML = `<span class="text-danger">${e.message}</span>`;
                }
            }

            document.addEventListener('DOMContentLoaded', () => {
                loadHealth();
                loadSystemInfo();
                loadLogFiles().then(() => loadLatestLog());

                document.getElementById('refreshSystemInfo')?.addEventListener('click', loadSystemInfo);
                document.getElementById('refreshLog')?.addEventListener('click', loadLatestLog);
                document.getElementById('logDateSelect')?.addEventListener('change', e => {
                    currentDate = e.target.value;
                    loadLatestLog();
                });
                document.getElementById('logModuleSelect')?.addEventListener('change', e => {
                    currentModule = e.target.value;
                    loadLatestLog();
                });
            });
        </script>
